<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>DevOps Task Manager</title>

  <style>
    * { box-sizing: border-box; }

    body {
      font-family: Arial, sans-serif;
      background: #f1f5f9;
      color: #172033;
      margin: 0;
      padding: 32px 16px;
    }

    main {
      max-width: 1000px;
      margin: auto;
    }

    h1 { margin-bottom: 8px; }

    .panel {
      background: white;
      border-radius: 12px;
      padding: 22px;
      margin: 20px 0;
      box-shadow: 0 4px 16px #0000000b;
    }

    input, textarea, select, button {
      font: inherit;
      padding: 10px;
      margin: 5px 0;
      border-radius: 6px;
      border: 1px solid #cbd5e1;
    }

    input, textarea, select { width: 100%; }

    button {
      background: #2563eb;
      color: white;
      border: none;
      cursor: pointer;
    }

    button.delete { background: #dc2626; }
    .task { border-top: 1px solid #e2e8f0; padding: 16px 0; }
    .task form { margin-top: 8px; }
    .muted { color: #64748b; }

    @media (min-width: 700px) {
      .fields { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
    }
  </style>
</head>

<body>
<main>
  <h1>DevOps Task Manager</h1>
  <p class="muted">CRUD application · Node.js · MySQL · AWS</p>

  <section class="panel">
    <h2>Create a task</h2>

    <form action="/tasks" method="POST">
      <label for="title">Task title</label>
      <input
        id="title"
        name="title"
        maxlength="150"
        required
        placeholder="Example: Learn Docker"
      >

      <label for="description">Description</label>
      <textarea
        id="description"
        name="description"
        rows="3"
        placeholder="Task details"
      ></textarea>

      <button type="submit">Add task</button>
    </form>
  </section>

  <section class="panel">
    <h2>All tasks (<%= tasks.length %>)</h2>

    <% if (tasks.length === 0) { %>
      <p class="muted">No tasks yet. Create your first task.</p>
    <% } %>

    <% tasks.forEach(task => { %>
      <article class="task">
        <h3><%= task.title %></h3>
        <p><%= task.description || "No description" %></p>
        <p class="muted">
          ID: <%= task.id %> ·
          Status: <%= task.status %> ·
          Created: <%= task.created_at %>
        </p>

        <form action="/tasks/<%= task.id %>/update" method="POST">
          <div class="fields">
            <div>
              <label>Title</label>
              <input
                name="title"
                value="<%= task.title %>"
                maxlength="150"
                required
              >
            </div>

            <div>
              <label>Description</label>
              <input
                name="description"
                value="<%= task.description || '' %>"
              >
            </div>
          </div>

          <label>Status</label>
          <select name="status">
            <option value="pending" <%= task.status === "pending" ? "selected" : "" %>>
              Pending
            </option>
            <option value="in_progress" <%= task.status === "in_progress" ? "selected" : "" %>>
              In progress
            </option>
            <option value="completed" <%= task.status === "completed" ? "selected" : "" %>>
              Completed
            </option>
          </select>

          <button type="submit">Update task</button>
        </form>

        <form
          action="/tasks/<%= task.id %>/delete"
          method="POST"
          onsubmit="return confirm('Delete this task?')"
        >
          <button class="delete" type="submit">Delete task</button>
        </form>
      </article>
    <% }) %>
  </section>
</main>
</body>
</html>
